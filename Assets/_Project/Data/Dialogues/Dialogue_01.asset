  m_Script: {fileID: 11500000, guid: 42f7eb367c13169478e34cf309609beb, type: 3}
  m_Name: Dialogue_01
  m_EditorClassIdentifier: DiosPunk.Flow::DiosPunk.Flow.DialogueData
  _lines:
  - speaker: Narrador
    text: Rosario. Un cuarto chico, una guitarra con las cuerdas justas y muchas
      ganas de que alguien escuche.
    portrait: {fileID: 0}
  - speaker: Dios Punk
    text: "Tres acordes alcanzan. Este cuarto suena m\xE1s fuerte que cualquier estadio."
    portrait: {fileID: 21300000, guid: 8df356341b82c1d488e1058091925b88, type: 3}
  - speaker: "Mam\xE1"
    text: "\xBFOtra vez ensayando? Baj\xE1 un poquito el volumen, que los vecinos
      tambi\xE9n tienen o\xEDdos."
    portrait: {fileID: 0}
  - speaker: Dios Punk
    text: "Mam\xE1, los vecinos son mi primer p\xFAblico."
    portrait: {fileID: 21300000, guid: 8df356341b82c1d488e1058091925b88, type: 3}
  - speaker: Narrador
    text: "As\xED empez\xF3 todo: con ruido, con humor y sin pedir permiso."
    portrait: {fileID: 0}
  _choicePrompt: 
  _choices: []
