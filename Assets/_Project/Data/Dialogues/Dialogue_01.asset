  m_Script: {fileID: 11500000, guid: 42f7eb367c13169478e34cf309609beb, type: 3}
  m_Name: Dialogue_01
  m_EditorClassIdentifier: DiosPunk.Flow::DiosPunk.Flow.DialogueData
  _lines:
  - speaker: Narrador
    text: Escena de prueba del nivel 1. El guion todavia no esta definido.
    portrait: {fileID: 0}
  - speaker: Dios Punk
    text: Linea de ejemplo con retrato. Aca iria una anecdota breve del nivel.
    portrait: {fileID: 21300000, guid: 8df356341b82c1d488e1058091925b88, type: 3}
  - speaker: Amigo
    text: Otra linea de ejemplo, dicha por un companero de banda o un desconocido
      en la calle.
    portrait: {fileID: 0}
  - speaker: Dios Punk
    text: Ultima linea antes de subir al escenario.
    portrait: {fileID: 21300000, guid: 8df356341b82c1d488e1058091925b88, type: 3}
