  m_Script: {fileID: 11500000, guid: 42f7eb367c13169478e34cf309609beb, type: 3}
  m_Name: Dialogue_02
  m_EditorClassIdentifier: DiosPunk.Flow::DiosPunk.Flow.DialogueData
  _lines:
  - speaker: Narrador
    text: "Un garaje, amplificadores prestados y una banda con nombre de sue\xF1o:
      Sue\xF1os Punk Rock."
    portrait: {fileID: 0}
  - speaker: "Compa\xF1ero de banda"
    text: Si no sale prolijo, que salga fuerte.
    portrait: {fileID: 0}
  - speaker: Dios Punk
    text: Prolijo es para los discos. Nosotros somos de vivo.
    portrait: {fileID: 21300000, guid: 8df356341b82c1d488e1058091925b88, type: 3}
  - speaker: Amigo
    text: "Hay un bar que nos da la fecha del s\xE1bado. \xBFNos animamos?"
    portrait: {fileID: 0}
  - speaker: Dios Punk
    text: Claro. Total, lo peor que puede pasar es que suene a punk.
    portrait: {fileID: 21300000, guid: 8df356341b82c1d488e1058091925b88, type: 3}
  _choicePrompt: "\xBFC\xF3mo encar\xE1s el primer recital?"
  _choices:
  - label: Con calma
    variable: 1
    value: -1
  - label: Como siempre
    variable: 1
    value: 0
  - label: A todo volumen
    variable: 1
    value: 1
