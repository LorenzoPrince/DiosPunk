MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 42f7eb367c13169478e34cf309609beb, type: 3}
  m_Name: Dialogue_03
  m_EditorClassIdentifier: DiosPunk.Flow::DiosPunk.Flow.DialogueData
  _lines:
  - speaker: Narrador
    text: "La peatonal C\xF3rdoba al mediod\xEDa: pasos apurados, vidrieras y un
      tipo con una guitarra."
    portrait: {fileID: 0}
  - speaker: "Transe\xFAnte"
    text: "\xBFEso es m\xFAsica o se te cay\xF3 la p\xFAa al piso?"
    portrait: {fileID: 0}
  - speaker: Dios Punk
    text: Es lo que tengo y lo toco igual.
    portrait: {fileID: 21300000, guid: 8df356341b82c1d488e1058091925b88, type: 3}
  - speaker: "Otro transe\xFAnte"
    text: Che, al menos tiene actitud...
    portrait: {fileID: 0}
  - speaker: Narrador
    text: Algunos pasan de largo. Otros se frenan a escuchar. Alcanza con que uno
      se frene.
    portrait: {fileID: 0}
  _choicePrompt: "\xBFD\xF3nde te par\xE1s hoy?"
  _choices:
  - label: En la esquina de siempre
    variable: 2
    value: 0
  - label: Frente a la vidriera
    variable: 2
    value: 1
