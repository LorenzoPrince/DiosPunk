MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 42f7eb367c13169478e34cf309609beb, type: 3}
  m_Name: Dialogue_04
  m_EditorClassIdentifier: DiosPunk.Flow::DiosPunk.Flow.DialogueData
  _lines:
  - speaker: Narrador
    text: "Las escalinatas de la Facultad de Medicina: buen eco, cero permisos y
      p\xFAblico con apuntes bajo el brazo."
    portrait: {fileID: 0}
  - speaker: Purista
    text: Eso no es punk de verdad. Falta mugre y sobra entusiasmo.
    portrait: {fileID: 0}
  - speaker: Dios Punk
    text: "El punk es hacerlo vos mismo. Hasta el cartel lo pint\xE9 yo."
    portrait: {fileID: 21300000, guid: 8df356341b82c1d488e1058091925b88, type: 3}
  - speaker: Amigo
    text: Los volantes quedaron fotocopiados torcidos.
    portrait: {fileID: 0}
  - speaker: Dios Punk
    text: "Mejor. As\xED se nota que est\xE1n hechos a mano."
    portrait: {fileID: 21300000, guid: 8df356341b82c1d488e1058091925b88, type: 3}
  - speaker: Narrador
    text: "Sin sellos, sin productores, sin permiso: autogesti\xF3n pura."
    portrait: {fileID: 0}
  _choicePrompt: "\xBFQu\xE9 le respond\xE9s al purista?"
  _choices:
  - label: Con humor
    variable: 1
    value: -1
  - label: "Con una canci\xF3n"
    variable: 1
    value: 0
  - label: "M\xE1s fuerte todav\xEDa"
    variable: 1
    value: 1
