  m_Script: {fileID: 11500000, guid: 42f7eb367c13169478e34cf309609beb, type: 3}
  m_Name: Dialogue_05
  m_EditorClassIdentifier: DiosPunk.Flow::DiosPunk.Flow.DialogueData
  _lines:
  - speaker: Narrador
    text: "No todo el ruido viene de afuera. A veces el m\xE1s dif\xEDcil est\xE1
      adentro."
    portrait: {fileID: 0}
  - speaker: Dios Punk
    text: "Hay d\xEDas en que cuesta hasta levantar la guitarra."
    portrait: {fileID: 21300000, guid: 8df356341b82c1d488e1058091925b88, type: 3}
  - speaker: Amigo
    text: "Pero igual la levant\xE1s."
    portrait: {fileID: 0}
  - speaker: Dios Punk
    text: "Porque si me quedo callado, gana el silencio. As\xED que... a tocar."
    portrait: {fileID: 21300000, guid: 8df356341b82c1d488e1058091925b88, type: 3}
  - speaker: Narrador
    text: "Esta es la canci\xF3n m\xE1s larga. Y tambi\xE9n la m\xE1s tuya."
    portrait: {fileID: 0}
  _choicePrompt: "\xBFC\xF3mo encar\xE1s esta canci\xF3n?"
  _choices:
  - label: Paso a paso
    variable: 1
    value: -1
  - label: Con todo
    variable: 1
    value: 0
  - label: Sin red
    variable: 1
    value: 1
